# Copia a .env y completa. API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_tu_key_aqui
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
# Cambia esto por un valor largo y aleatorio (firma los tokens de login):  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto
DATABASE_URL=sqlite:///biblioteca.db
# SQL_ECHO=1   # descomenta para ver las consultas SQL
