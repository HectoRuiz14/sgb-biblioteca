# Copia a .env y completa. API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_tu_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
# Cambia esto por un valor largo y aleatorio (firma los tokens de login):  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///biblioteca.db
# Credenciales locales para docker-compose (cámbialas para entornos compartidos).
POSTGRES_DB=biblioteca
POSTGRES_USER=sgb
POSTGRES_PASSWORD=biblioteca_dev
# SQL_ECHO=1   # descomenta para ver las consultas SQL

# Usuario demo (lo crea scripts/seed.py). Si DEMO_PASSWORD queda vacío, seed.py genera una clave y te la muestra.
DEMO_EMAIL=demo@sgb.local
DEMO_PASSWORD=
